# NHANES and derived participant-level data
# Keep directory placeholders but do not commit raw or processed data.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Fitted models and intermediate analysis artifacts
outputs/models/*
!outputs/models/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/final/*
!outputs/final/.gitkeep